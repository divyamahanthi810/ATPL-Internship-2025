--  Show student count per department
SELECT DEPT_ID,COUNT(*) AS TOTAL_STUDENTS FROM StudentDivya GROUP BY Dept_ID;

-- find the average age of students per department
SELECT (SELECT dept_Name FROM DepartmentDivya WHERE DepartmentDivya.dept_ID=StudentDivya.dept_ID) AS Dept_Name,
    AVG(age) AS Avg_age
FROM StudentDivya
GROUP BY StudentDivya.dept_ID;

SELECT DEPT_ID,AVG(AGE) FROM STUDENTDivya GROUP BY DEPT_ID;

-- get max and min age in the entire table
SELECT MAX(age) AS max_age,MIN(age) AS min_age FROM StudentDivya;


CREATE TABLE Accounts_Divya 
	(account_ID varchar(10) primary key , holder_name varchar(50) not null, balance float);
INSERT INTO Accounts_Divya (account_ID,holder_name,balance) VALUES ('Account1','Alice',5000),('Account2','BOB',3000),('Account3','Charlie',4000);
SELECT * FROM Accounts_Divya;

-- Start a Transaction – Transfer ₹1000 from Alice to Bob
START TRANSACTION;
-- updated few column values 
UPDATE Accounts_Divya SET balance=balance-1000 WHERE holder_name = 'Alice';
UPDATE Accounts_Divya SET balance=balance+1000 WHERE holder_name = 'Bob';
SELECT * FROM Accounts_Divya;
-- Undoes all changes made in the current transaction that havent been commited.
ROLLBACK;
SELECT * FROM Accounts_Divya; 

-- New Transaction with SAVEPOINT
START TRANSACTION;
UPDATE Accounts_Divya SET balance=balance-1000 WHERE holder_name = 'Alice';
SAVEPOINT after_debit;
UPDATE Accounts_Divya SET balance=balance+1000 WHERE holder_name = 'Bob';
UPDATE Accounts_Divya SET balance=balance+500 WHERE holder_name = 'Charlie';
ROLLBACK TO after_debit;

COMMIT;

